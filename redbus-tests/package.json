{
  "name": "redbus-playwright-automation",
  "version": "1.0.0",
  "description": "RedBus Automation Suite with Playwright, TypeScript, and Auto-Healing Capabilities",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:smoke": "npx playwright test --grep \"@smoke\"",
    "test:sanity": "npx playwright test --grep \"@sanity\"",
    "test:regression": "npx playwright test --grep \"@regression\"",
    "test:api": "npx playwright test --grep \"@api\"",
    "test:mobile": "npx playwright test --grep \"@mobile\"",
    "test:perf": "npx playwright test --grep \"@perf\"",
    "test:parallel": "npx playwright test --workers=4",
    "test:shard1": "npx playwright test --shard=1/3",
    "test:shard2": "npx playwright test --shard=2/3",
    "test:shard3": "npx playwright test --shard=3/3",
    "report:merge": "npx playwright merge-reports ./all-blob-reports --reporter=html",
    "report:show": "npx playwright show-report",
    "heal": "npx ts-node heal-tests.ts",
    "docker:build": "docker build -t redbus-playwright-tests .",
    "docker:test": "docker run --rm --ipc=host -v $(pwd)/test-results:/app/test-results -v $(pwd)/playwright-report:/app/playwright-report redbus-playwright-tests",
    "docker:test:smoke": "docker run --rm --ipc=host -v $(pwd)/playwright-report:/app/playwright-report redbus-playwright-tests npm run test:smoke",
    "docker:heal": "docker run --rm --ipc=host -v $(pwd)/test-results:/app/test-results redbus-playwright-tests npm run heal",
    "docker:compose": "docker-compose up --build"
  },
  "keywords": ["playwright", "testing", "redbus", "sharding", "auto-healing"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^25.9.2",
    "typescript": "^5.5.3"
  }
}

